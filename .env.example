NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://frankjeans:frankjeans@localhost:5432/frankjeans

# JWT — genera secretos reales con: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Dominio para el atributo Domain de las cookies HttpOnly (opcional en local)
COOKIE_DOMAIN=

# Orígenes exactos del frontend Angular, separados por coma si hace falta más de uno
# (sin *, CORS con credentials requiere origen explícito; localhost y 127.0.0.1 cuentan
# como orígenes distintos para el navegador aunque apunten a la misma máquina)
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Mercado Pago — nunca la Access Token al frontend, solo la Public Key
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Skydropx PRO — ojo: sandbox y producción son HOSTS distintos, no el mismo host
# con distinto flag. Credenciales de sandbox solo funcionan contra sb-pro.*.
# sandbox:    SKYDROPX_API_URL=https://sb-pro.skydropx.com
# producción: SKYDROPX_API_URL=https://pro.skydropx.com
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=
SKYDROPX_ENVIRONMENT=sandbox
SKYDROPX_API_URL=https://sb-pro.skydropx.com

# Dirección física de la tienda (origen fijo de todos los envíos)
STORE_ORIGIN_STREET=Calle 5 de Mayo 123
STORE_ORIGIN_POSTAL_CODE=72000
STORE_ORIGIN_CITY=Puebla
STORE_ORIGIN_STATE=Puebla
STORE_ORIGIN_NEIGHBORHOOD=Centro
STORE_ORIGIN_COUNTRY_CODE=MX
STORE_ORIGIN_NAME=Frank Jeans
STORE_ORIGIN_PHONE=2221234567
STORE_ORIGIN_EMAIL=contacto@frankjeans.com

# Operación del vendedor, nunca preguntada al comprador: true = Skydropx
# recoge en la tienda, false = se deja el paquete en la paquetería.
ENVIO_REQUIERE_PICKUP=true

# Opcional — esquema de firma del webhook de Skydropx no confirmado oficialmente
SKYDROPX_WEBHOOK_SECRET=

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5
